# --- Required in production ---
NODE_ENV=production
# One long random secret (>=48 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# All password pepper, field-encryption, file-encryption and OTP keys are derived from it.
# NEVER commit it, NEVER change it after data exists (encrypted data would become unreadable). Back it up safely.
APP_SECRET=
PORT=3000
HOST=127.0.0.1
# Set to 1 when the app runs behind nginx (reads real client IP from X-Real-IP)
TRUST_PROXY=1
DATA_DIR=./data

# --- SMS (login by phone). console = prints the code in the server log (development only) ---
SMS_DRIVER=console
# SMS_DRIVER=http   -> a generic JSON webhook; adapt lib/sms.js to your provider
# SMS_URL=
# SMS_API_KEY=

# --- Development only (never in production) ---
# DEV_SHOW_OTP=1
