# dadgar-web — نمونه‌ی متغیرهای محیطی (CMD-002 + CMD-028)
# روی Vercel در Project Settings تنظیم می‌شود؛ این فایل فقط برای هارنس محلی است.

# --- پایگاه داده (الزامی) ---
DATABASE_URL=postgresql://<role>.<project-ref>@<pooler-host>:6543/postgres?sslmode=require

# --- امضای نشست (الزامی؛ >=48 نویسه) ---
APP_SECRET=change-me-to-a-long-random-string-min-48-chars

# --- رفتار محلی/توسعه ---
NODE_ENV=development
TRUST_PROXY=0
DEV_SHOW_OTP=1
SMS_DRIVER=console

# --- CMD-028/029: درگاه پرداخت آنلاین (زیبال — انتخاب مدیر در CMD-029) ---
# PROVIDER=zibal و MERCHANT_ID از پنل زیبال (برای تست بدون ثبت‌نام: «zibal»).
# CALLBACK_BASE = آدرس production (مثلا https://dadgar-theta.vercel.app) —
# مسیر callback خودکار به /api/payments/callback می‌چسبد.
# کلید پذیرنده هرگز در کد/موبایل قرار نمی‌گیرد — فقط همین env سرور.
# PAYMENT_API_BASE فقط برای هارنس محلی (fake-zibal) — روی Vercel تنظیم نشود.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_BASE=
PAYMENT_API_BASE=
